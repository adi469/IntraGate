# ─── IntraGate Gateway Configuration ───────────────────────────
# Only minimal settings are in .env — everything else is managed
# via the Admin Panel at http://localhost:8585

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# MUST be at least 32 characters in length.
GATEWAY_SECRET_KEY=CHANGE-ME-MUST-BE-AT-LEAST-32-CHARS-LONG

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# MUST be a valid 32-byte URL-safe base64-encoded Fernet key.
GATEWAY_ENCRYPTION_KEY=CHANGE-ME-MUST-BE-A-VALID-FERNET-KEY

# Network binding
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=9000
ADMIN_PORT=8585

# PostgreSQL configuration
POSTGRES_PASSWORD=CHANGE-ME-SECURE-DATABASE-PASSWORD
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE-ME-SECURE-DATABASE-PASSWORD@localhost:5432/intragate_gateway

# Comma-separated list of trusted proxy IPs/subnets (e.g. 127.0.0.1, 10.0.0.1)
# If set, X-Forwarded-For headers from these IPs will be trusted.
TRUSTED_PROXIES=127.0.0.1,::1

# Developer Mode (set to "true" to allow mock login bypass - DEV ONLY, refuse in production)
GATEWAY_DEV_MODE=false
