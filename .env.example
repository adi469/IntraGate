# ─── IntraGate Gateway Configuration ───────────────────────────
# Copy this file to .env and fill in the values before starting.
#   cp .env.example .env
# Everything else (Entra ID, apps, portal, session settings) is
# managed via the Admin Panel at http://localhost:8585
# ────────────────────────────────────────────────────────────────


# ── Secret Keys ─────────────────────────────────────────────────

# Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# MUST be at least 32 characters long.
GATEWAY_SECRET_KEY=CHANGE-ME-MUST-BE-AT-LEAST-32-CHARS-LONG

# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# MUST be a valid 32-byte URL-safe base64-encoded Fernet key.
GATEWAY_ENCRYPTION_KEY=CHANGE-ME-MUST-BE-A-VALID-FERNET-KEY


# ── Network Binding ──────────────────────────────────────────────

GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=9000
ADMIN_PORT=8585


# ── PostgreSQL ───────────────────────────────────────────────────

# Password for the Postgres user. Used by Docker Compose to create
# the database and by DATABASE_URL below to connect to it.
POSTGRES_PASSWORD=CHANGE-ME-SECURE-DATABASE-PASSWORD

# ⚠️  DATABASE_URL hostname depends on how you run the app:
#
#   Docker Compose / Portainer  →  use the service name "database"
#   DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@database:5432/intragate_gateway
#
#   Local dev (outside Docker)  →  use "localhost"
#   DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/intragate_gateway
#
# Replace YOUR_PASSWORD with the same value as POSTGRES_PASSWORD above.
# Default below is set for Docker Compose / Portainer deployments.
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE-ME-SECURE-DATABASE-PASSWORD@database:5432/intragate_gateway


# ── Trusted Proxies ──────────────────────────────────────────────

# Comma-separated list of trusted proxy IPs/subnets.
# X-Forwarded-For headers from these IPs will be trusted.
# Example: TRUSTED_PROXIES=127.0.0.1,10.0.0.1,172.16.0.0/12
TRUSTED_PROXIES=127.0.0.1,::1


# ── Developer Mode ───────────────────────────────────────────────

# Set to "true" to enable mock login bypass.
# ⚠️  NEVER enable in production!
GATEWAY_DEV_MODE=false
